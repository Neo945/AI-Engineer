# --- Core ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true

# --- API ---
API_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=coding
POSTGRES_PASSWORD=coding
POSTGRES_DB=coding_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://coding:coding@localhost:5432/coding_agent

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Embeddings ---
# Fixed pgvector dimension. Changing this after vectors are inserted requires
# a data migration, so pick once and never move it.
EMBEDDING_DIMENSION=1536
# EMBEDDING_ENABLED=true computes vectors for indexed chunks and memory
# entries. The default provider "hash" is offline, deterministic, and free;
# "openai" uses any OpenAI-compatible /embeddings endpoint (key/base URL fall
# back to the LLM settings when unset).
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Executor / Sandbox ---
# Sandbox containers run terminal commands. They are ephemeral,
# resource-capped, non-root, network-less, and hard-timeout bounded.
EXECUTOR_IMAGE=coding-agent-executor:latest
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_NANOS=1000000000
SANDBOX_NETWORK_ENABLED=false
SANDBOX_DEFAULT_TIMEOUT_MS=30000

# --- LLM provider ---
# LLM_PROVIDER selects the adapter: anthropic | openai | gemini.
# For OpenAI-compatible local backends (vLLM, Ollama) set LLM_PROVIDER=openai
# and LLM_BASE_URL to the local server (e.g. http://localhost:8000/v1).
# For Gemini, set LLM_PROVIDER=gemini and LLM_MODEL (e.g. gemini-2.0-flash);
# the API key may also come from GEMINI_API_KEY or GOOGLE_API_KEY.
# Default local config points at the opencode zen endpoint (model: big-pickle);
# copy .env.example to .env and fill in LLM_API_KEY.
LLM_PROVIDER=openai
LLM_MODEL=big-pickle
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120

# --- Retrieval context ---
# ContextAssembler feeds a ranked, size-bounded window of matching code
# chunks into each agent run. Disable to skip retrieval entirely.
RETRIEVAL_ENABLED=true
RETRIEVAL_MAX_CHUNKS=20
RETRIEVAL_MAX_CHARS=12000

# --- Command safety policy ---
# Sandboxed terminal commands are classified against deny/confirm rules.
# Deny-tier commands (rm, git reset --hard, git push --force, ...) are
# blocked outright; confirm-tier commands require confirm=true on the call.
# Extra patterns (JSON arrays of regexes) extend the built-in lists.
COMMAND_POLICY_ENABLED=true
COMMAND_DENY_EXTRA=[]
COMMAND_CONFIRM_EXTRA=[]

# --- Test-and-repair ---
# The tester stage runs the suite, and on failure fixes then re-runs up to
# TEST_MAX_REPAIRS times before reporting FAIL. TEST_COMMAND overrides the
# auto-detected runner (pytest / jest); empty means auto-detect.
TEST_MAX_REPAIRS=2
TEST_COMMAND=

# --- MCP tool integration ---
# Expose tools published by external Model Context Protocol (MCP) servers via
# the single `mcp_call` bridge tool (e.g. GitHub, Jira, databases, cloud).
# MCP_SERVERS_FILE points at a JSON file, e.g.:
#   {"servers": {"github": {"command": "github-mcp-server", "args": ["stdio"]}}}
# Inspect what is available with: engineer mcp list
MCP_ENABLED=false
MCP_SERVERS_FILE=
MCP_TIMEOUT_SECONDS=30
