# --- Core ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true

# --- API ---
API_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=coding
POSTGRES_PASSWORD=coding
POSTGRES_DB=coding_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://coding:coding@localhost:5432/coding_agent

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Embeddings ---
# Fixed pgvector dimension. Changing this after vectors are inserted requires
# a data migration, so pick once and never move it.
EMBEDDING_DIMENSION=1536

# --- Executor / Sandbox ---
# Sandbox containers run terminal commands. They are ephemeral,
# resource-capped, non-root, network-less, and hard-timeout bounded.
EXECUTOR_IMAGE=coding-agent-executor:latest
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_NANOS=1000000000
SANDBOX_NETWORK_ENABLED=false
SANDBOX_DEFAULT_TIMEOUT_MS=30000

# --- LLM provider ---
# LLM_PROVIDER selects the adapter: anthropic | openai.
# For OpenAI-compatible local backends (vLLM, Ollama) set LLM_PROVIDER=openai
# and LLM_BASE_URL to the local server (e.g. http://localhost:8000/v1).
# Default local config points at the opencode zen endpoint (model: big-pickle);
# copy .env.example to .env and fill in LLM_API_KEY.
LLM_PROVIDER=openai
LLM_MODEL=big-pickle
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
